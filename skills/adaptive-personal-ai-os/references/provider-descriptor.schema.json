{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Moyang1412/adaptive-personal-ai-os/blob/main/skills/adaptive-personal-ai-os/references/provider-descriptor.schema.json",
  "title": "ZhiXu memory provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "version", "kind", "location",
    "local", "network_required", "capabilities", "storage_location",
    "license", "maintenance_status", "interface", "source_of_truth",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"enum": ["native", "installed-tool", "external-engine", "file-fallback"]},
    "location": {"type": "string", "minLength": 1},
    "local": {"type": "boolean"},
    "network_required": {"type": "boolean"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "save", "read", "correct", "delete", "scope", "cross_session",
          "cross_agent", "concurrent_write_guard", "import_export"
        ]
      }
    },
    "storage_location": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "maintenance_status": {"enum": ["active", "maintained", "unknown", "abandoned"]},
    "interface": {"type": "string", "minLength": 1},
    "source_of_truth": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documented", "installed", "enabled", "callable", "isolated_test"],
      "properties": {
        "documented": {"type": "boolean"},
        "installed": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "callable": {"type": "boolean"},
        "isolated_test": {"type": "boolean"}
      }
    },
    "verified_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "unverified_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  }
}
